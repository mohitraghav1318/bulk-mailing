# =============================================================================
# .env.example — Template for environment variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git!
# =============================================================================

# --- SMTP CONFIG TOGGLE ---
# Set to "mailpit" for local testing (no auth needed)
# Set to "gmail"   for sending real emails via Gmail
SMTP_PROVIDER=mailpit

# --- Mailpit Config (local testing) ---
# Mailpit runs on localhost:1025 and catches all outgoing mail.
# View caught emails at http://localhost:8025
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# --- Gmail Config (real sending) ---
# Host and port for Gmail's SMTP server.
# Gmail requires TLS on port 587.
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587

# Your Gmail address
GMAIL_USER=mohitraghav1318@gmail.com

# Gmail App Password (NOT your regular password).
# Generate one at: https://myaccount.google.com/apppasswords
# You must have 2-Step Verification enabled on your Google account first.
GMAIL_APP_PASSWORD=your_16_char_app_password

# --- Sender Info ---
# "From" name shown in the recipient's inbox
SENDER_NAME=Team StrawHat
